# Copy to .env and fill in. Never commit .env.

# Prefer 127.0.0.1 over localhost (avoids macOS IPv6 [::1] canonical hangs)
LOCAL_URL=http://127.0.0.1:8888
DEPLOY_URL=https://example.com

# Theme folder name under wp-content/themes/ (after Paso 0 rename)
THEME_SLUG=starter

# ACF Pro (incluido en el repo; usado por pack/deploy)
ACF_PRO_SRC=./wp-content/plugins/advanced-custom-fields-pro

# Preview tunnel (ngrok Basic Auth) — npm run tunnel
NGROK_BASIC_USER=starter-preview
NGROK_BASIC_PASS=

# Admin (after wp:start → npm run admin:rotate)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=

# FTP upload (optional; used by npm run deploy:ftp)
DEPLOY_FTP_HOST=ftp.example.com
DEPLOY_FTP_USER=
DEPLOY_FTP_PASSWORD=
DEPLOY_FTP_REMOTE_DIR=/public_html
DEPLOY_FTP_SECURE=false
# DEPLOY_FTP_VERBOSE=true
