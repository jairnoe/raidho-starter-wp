{
  "type": "workspace_readwrite",
  "disableTmpWrite": true,
  "networkPolicy": {
    "default": "deny",
    "allow": [
      "registry.npmjs.org",
      "registry.yarnpkg.com",
      "*.npmjs.org",
      "*.wordpress.org",
      "api.wordpress.org",
      "downloads.wordpress.org",
      "*.docker.io",
      "ghcr.io",
      "raw.githubusercontent.com",
      "*.githubusercontent.com",
      "github.com"
    ]
  }
}
